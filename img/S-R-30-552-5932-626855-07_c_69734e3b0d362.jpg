							  placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
							  aria-describedby="password"
							  autocomplete="off"
							/>
							<span class="input-group-text cursor-pointer" id="togglePassword"><i class="bx bx-hide"  id="toggleIcon"></i></span>
						  </div>
						</div>
